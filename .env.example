# #genai: Copy to `.env` and adjust. Only EXPO_PUBLIC_* vars are exposed to the client bundle.
# Never put secrets (service role keys, private API keys) in this file.

# Base URL of card-buddy-backend.
#
# You normally do NOT need to change this. `localhost` points at the device itself on
# simulators, emulators and phones, so `src/config/env.js` automatically rewrites a loopback
# host to one the device can actually reach:
#   - iOS simulator / physical device -> the dev server's LAN IP (e.g. 192.168.1.2)
#   - Android emulator               -> 10.0.2.2 (its alias for the host machine)
# Non-loopback URLs (staging/production) are passed through untouched.
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT=15000

# One of: development | staging | production
EXPO_PUBLIC_ENV=development

# Supabase (anon / publishable only — never service role)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
